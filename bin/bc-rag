#!/usr/bin/env bash
set -euo pipefail

# Stay in the caller's working directory. `bc-rag project add` writes `.bc-rag.json`
# next to cwd (or --root), not next to this tool repo.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ -x "$ROOT/.venv/bin/bc-rag" ]]; then
  exec "$ROOT/.venv/bin/bc-rag" "$@"
fi

exec uv run --project "$ROOT" bc-rag "$@"
